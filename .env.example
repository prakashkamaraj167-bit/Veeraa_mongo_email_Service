# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# EMAIL SERVICE (Choose ONE of the free standard options below)
# ==============================================================================
# OPTION 1: Resend (Recommended: 3,000 free emails/month - https://resend.com)
# Get a free API key and paste here:
RESEND_API_KEY=

# OPTION 2: Gmail SMTP (Free forever using a Google Account App Password)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OPTION 3: Any Standard SMTP Provider (e.g., Brevo free 300 emails/day, Mailgun, SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional sender configurations
EMAIL_FROM_NAME="Veeraa"
EMAIL_FROM=

# Legacy provider (optional fallback)
EMERGENT_EMAIL_KEY=

# RAZORPAY_KEY_ID: Razorpay key for checkout (leave empty for demo payment mode)
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Razorpay secret key
RAZORPAY_KEY_SECRET=

# MONGO_URL: MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGO_URL=

# DB_NAME: MongoDB database name (default: veeraa)
DB_NAME="veeraa"
